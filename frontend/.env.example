# ===========================================================================
# CivicBridge — copy to .env.local and fill in. Never commit .env.local.
# ===========================================================================

# Postgres (Neon). Required: without it reports are analysed but not saved.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ===========================================================================
# Authentication (Clerk) — optional; anonymous sign-in works without it
# ===========================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ===========================================================================
# Detection service (FastAPI + YOLOv8)
# ===========================================================================
GARBAGE_API_URL="http://localhost:8000"
GARBAGE_API_TIMEOUT_MS="30000"

# ===========================================================================
# Image storage (Cloudinary) — without it images fall back to public/uploads,
# which is development only and is lost on the next build.
# ===========================================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="civicbridge/garbage"

# ===========================================================================
# Notice drafting (Groq) — without it the deterministic template is used
# ===========================================================================
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_MODEL="llama-3.3-70b-versatile"

# ===========================================================================
# Email delivery
#
#   dry_run  -> compose and log only; nothing leaves the machine (default)
#   sandbox  -> deliver everything to EMAIL_OVERRIDE_TO, real recipient kept
#               in the subject line and in EmailLog.intendedTo
#   live     -> deliver to the real authority. Also requires EMAIL_ALLOW_LIVE=true.
# ===========================================================================
EMAIL_MODE="dry_run"
EMAIL_OVERRIDE_TO="your.personal@example.com"
EMAIL_ALLOW_LIVE="false"
EMAIL_FROM="CivicBridge <onboarding@resend.dev>"
RESEND_API_KEY="re_your_resend_api_key"

# ===========================================================================
# Reverse geocoding (Nominatim / OpenStreetMap — free, no key required)
# Nominatim's usage policy requires a contactable User-Agent.
# ===========================================================================
GEOCODE_PROVIDER="nominatim"
GEOCODE_USER_AGENT="CivicBridge/0.1 (civic issue reporting)"
